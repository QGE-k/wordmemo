# WordMemo 环境变量模板
# 复制本文件为 .env 并填入真实值（.env 已被 gitignore，不会提交）
# 本地开发可不填，数据库默认用 SQLite；只有要用 AI 功能才需填 AGNES_API_KEY

# Agnes AI 配置（AI 单词分析/识别用）
AGNES_API_KEY=
AGNES_BASE_URL=https://apihub.agnes-ai.com/v1
AGNES_MODEL=agnes-2.0-flash

# 数据库连接（本地默认 SQLite，留空即可；部署到云端时填 Neon 连接串）
# DATABASE_URL=postgresql://user:password@ep-xxx.neon.tech/wordmemo?sslmode=require

# 应用密钥（本地可不填，部署时建议设置随机值）
# SECRET_KEY=your-random-secret-key
