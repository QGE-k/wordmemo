<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- 主主题 -->
    <style name="Theme.WordMemo" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryDark">@color/primary_dark</item>
        <item name="colorAccent">@color/primary_light</item>
        <item name="android:windowBackground">@color/bg_page</item>
    </style>

    <!-- 启动页主题 -->
    <style name="Theme.WordMemo.Splash" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowBackground">@color/primary</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:statusBarColor">@color/primary</item>
    </style>

</resources>
